# ---------------------------------------------------------------------------
# Portkey (LLM gateway) - used by the pipeline to generate the test plan,
# scenarios, testdata, test_flow.py, risks and fix suggestions.
# ---------------------------------------------------------------------------
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_AUTH_TOKEN=cole_o_token_rotacionado_aqui
LLM_MODEL=@nome-do-modelo-no-portkey

# Path of the prompt template, relative to this repository.
AI_PROMPT_FILE=prompt/prompt_template.txt

# Language of the generated answers (ISO code).
LANGUAGE_CODE=pt-BR

# ---------------------------------------------------------------------------
# LEGACY - iFlow extraction through the SAP Integration Suite REST API.
# NOT part of the CI flow: the iFlow arrives through the native Git Push (Git Access).
# Keep it only for local use with the old scripts in legacy/.
# Do not configure these variables on GitHub.
# ---------------------------------------------------------------------------
SAP_IS_BASE_URL=
SAP_IS_USERNAME=
SAP_IS_PASSWORD=
